# ===== App =====
NEXT_PUBLIC_APP_NAME=TemuLapak
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ===== API / Backend =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# ===== Auth (kalau pakai Supabase) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ===== Payment Gateway (public key only) =====
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
# atau
# NEXT_PUBLIC_XENDIT_PUBLIC_KEY=xxxx

# ===== Upload / Storage (public bucket URL) =====
NEXT_PUBLIC_STORAGE_BUCKET_URL=https://xxxxx.supabase.co/storage/v1/object/public

# ===== Feature Flags (opsional) =====
NEXT_PUBLIC_ENABLE_AI_MATCHING=true
NEXT_PUBLIC_ENABLE_PAYMENT=true
NEXT_PUBLIC_ENABLE_MOU=false